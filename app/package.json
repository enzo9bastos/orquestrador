{
  "name": "orquestrador",
  "version": "0.1.0",
  "description": "Orquestrador: uma janela para conduzir vários agentes Claude Code em tmux",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "editor": "esbuild tela/editor/fonte.js --bundle --minify --format=iife --target=chrome130 --outfile=tela/editor.bundle.js --legal-comments=external"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/markdown": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "marked": "^18.1.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "author": "Enzo Bastos"
}
